{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tizen-sdk-skills/check-tizen-commands.sh\"" }]
      },
      {
        "matcher": "Write|Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tizen-sdk-skills/check-project-writes.sh\"" }]
      },
      {
        "matcher": "Skill|Agent|Task",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tizen-sdk-skills/check-skill-routing.sh\"" }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [{ "type": "command", "timeout": 20, "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/tizen-sdk-skills/check-update.js\" --host claude --cache-root \"$HOME/.claude/plugins/cache/tizen-platform\"" }]
      }
    ]
  }
}
